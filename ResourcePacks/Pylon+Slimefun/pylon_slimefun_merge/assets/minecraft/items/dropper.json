{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:diesel_breaker",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/diesel_machines/breaker"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "IGNITION_CHAMBER"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/basic_machines/ignition_chamber"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/dropper"
      }
    }
  }
}