{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:breeding_talisman_advanced",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/breeding_talisman_advanced"
        }
      },
      {
        "when": "pylon:breeding_talisman_palladium",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/breeding_talisman_palladium"
        }
      },
      {
        "when": "pylon:breeding_talisman_simple",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/breeding_talisman_simple"
        }
      },
      {
        "when": "pylon:breeding_talisman_ultimate",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/breeding_talisman_ultimate"
        }
      }
    ],
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "CHRISTMAS_CARAMEL_APPLE"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/christmas/christmas_caramel_apple"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "CHRISTMAS_CHOCOLATE_APPLE"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/christmas/christmas_chocolate_apple"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/apple"
      }
    }
  }
}