{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:dough",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/resources/dough"
        }
      },
      {
        "when": "pylon:sulfur",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/resources/sulfur"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "GN_SCRAMBLED_EGGS"
            }
          },
          "model": {
            "type": "model",
            "model": "gastronomicon:food/gn_scrambled_eggs"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "GN_CUSTARD"
            }
          },
          "model": {
            "type": "model",
            "model": "gastronomicon:food/gn_custard"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "CLT_TURMERIC"
            }
          },
          "model": {
            "type": "model",
            "model": "cultivation:products/clt_turmeric"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/yellow_dye"
      }
    }
  }
}