{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:fluid_tank_casing_tin",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/pipes/tin_tank_casing"
        }
      },
      {
        "when": "pylon:portable_fluid_tank_tin",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/pipes/tin_portable_tank"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "FOOD_FABRICATOR"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/energy/food_fabricator"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "FOOD_FABRICATOR_2"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/energy/food_fabricator_2"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/green_stained_glass"
      }
    }
  }
}