{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:hydraulic_motor",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/components/hydraulic_motor"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "COMPRESSOR"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/basic_machines/compressor"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "REFINERY"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/energy/refinery"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/piston_inventory"
      }
    }
  }
}