{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:diesel_press",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/diesel_machines/press"
        }
      },
      {
        "when": "pylon:press",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/machines/simple_machines/press"
        }
      }
    ],
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "MINI_FLUFFY_BARREL"
            }
          },
          "model": {
            "type": "model",
            "model": "fluffymachines:barrels/mini_fluffy_barrel"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/composter"
      }
    }
  }
}