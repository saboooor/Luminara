{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:enchanting_talisman_advanced",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/enchanting_talisman_advanced"
        }
      },
      {
        "when": "pylon:enchanting_talisman_palladium",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/enchanting_talisman_palladium"
        }
      },
      {
        "when": "pylon:enchanting_talisman_simple",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/enchanting_talisman_simple"
        }
      },
      {
        "when": "pylon:enchanting_talisman_ultimate",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/enchanting_talisman_ultimate"
        }
      },
      {
        "when": "rebar:guide_back",
        "model": {
          "type": "minecraft:model",
          "model": "rebar:item/ui/guide_back"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/enchanted_book"
      },
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_guide_mode": "SURVIVAL_MODE"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/gui/slimefun_guide"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_guide_mode": "CHEAT_MODE"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/gui/slimefun_cheat"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "_UI_BACK"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/gui/_ui_back"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "TOME_OF_KNOWLEDGE_SHARING"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/magical_gadgets/tome_of_knowledge_sharing"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "ENDER_FLAME"
            }
          },
          "model": {
            "type": "model",
            "model": "infinityexpansion:materials/ender_flame"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "IE_ENDER_FLAME"
            }
          },
          "model": {
            "type": "model",
            "model": "infinityexpansion2:tools/ender_flame"
          }
        }
      ]
    }
  },
  "oversized_in_gui": true
}