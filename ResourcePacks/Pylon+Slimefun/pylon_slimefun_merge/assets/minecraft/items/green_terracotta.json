{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:tin",
        "model": {
          "type": "model",
          "model": "pylon:block/fluids/tin"
        }
      },
      {
        "when": "pylon:fluid_pipe_tin",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/pipes/tin_pipe"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "FOOD_COMPOSTER"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/energy/food_composter"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "FOOD_COMPOSTER_2"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/energy/food_composter_2"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/green_terracotta"
      }
    }
  }
}