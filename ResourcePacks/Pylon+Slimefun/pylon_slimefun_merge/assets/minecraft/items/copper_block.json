{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:bronze_block",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/resources/bronze_block"
        }
      }
    ],
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "IE_COPPER_SINGULARITY"
            }
          },
          "model": {
            "type": "model",
            "model": "infinityexpansion2:singularities/copper_singularity"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/copper_block"
      }
    }
  }
}