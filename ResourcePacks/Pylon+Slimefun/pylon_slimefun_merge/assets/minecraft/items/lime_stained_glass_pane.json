{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:analogue_display",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/components/analogue_display"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "_UI_PREVIOUS_ACTIVE"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/gui/_ui_previous_active"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "_UI_NEXT_ACTIVE"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/gui/_ui_next_active"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "IE__UI_PRODUCING"
            }
          },
          "model": {
            "type": "model",
            "model": "infinityexpansion2:icons/ui_producing"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/lime_stained_glass_pane"
      }
    }
  }
}