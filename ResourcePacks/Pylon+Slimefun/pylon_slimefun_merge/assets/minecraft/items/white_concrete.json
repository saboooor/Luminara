{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:cargo_valve",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/cargo/cargo_valve"
        }
      },
      {
        "when": "pylon:cargo_valve:open",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/cargo/display/valve"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "RAINBOW_CONCRETE"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/magical_gadgets/rainbow_concrete"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "RAINBOW_CONCRETE_XMAS"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/christmas/rainbow_concrete_xmas"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/white_concrete"
      }
    }
  }
}