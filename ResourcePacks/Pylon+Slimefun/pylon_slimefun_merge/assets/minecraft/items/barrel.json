{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:cargo_buffer",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/machines/cargo/cargo_buffer"
        }
      }
    ],
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "GN_FERMENTER"
            }
          },
          "model": {
            "type": "model",
            "model": "gastronomicon:basic_machines/gn_fermenter"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "GN_LARGE_FERMENTER"
            }
          },
          "model": {
            "type": "model",
            "model": "gastronomicon:basic_machines/gn_large_fermenter"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "MEDIUM_FLUFFY_BARREL"
            }
          },
          "model": {
            "type": "model",
            "model": "fluffymachines:barrels/medium_fluffy_barrel"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/barrel"
      }
    }
  }
}