{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:cobalt",
        "model": {
          "type": "model",
          "model": "pylon:block/fluids/cobalt"
        }
      }
    ],
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "FLUID_PUMP"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/energy/fluid_pump"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/blue_terracotta"
      }
    }
  }
}