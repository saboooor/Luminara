{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:bronze_axe",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/tools/bronze_axe"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "FLUFFY_WRENCH"
            }
          },
          "model": {
            "type": "model",
            "model": "fluffymachines:wrenches/fluffy_wrench"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/golden_axe"
      }
    }
  }
}