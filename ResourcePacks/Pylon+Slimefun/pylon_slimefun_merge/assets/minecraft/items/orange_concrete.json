{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:lava",
        "model": {
          "type": "model",
          "model": "pylon:block/fluids/lava"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "RAINBOW_CONCRETE_HALLOWEEN"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/halloween/rainbow_concrete_halloween"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/orange_concrete"
      }
    }
  }
}