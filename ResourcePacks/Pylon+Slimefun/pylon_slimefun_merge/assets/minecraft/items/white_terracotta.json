{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:nickel",
        "model": {
          "type": "model",
          "model": "pylon:block/fluids/nickel"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "RAINBOW_CLAY"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/magical_gadgets/rainbow_clay"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "RAINBOW_CLAY_XMAS"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/christmas/rainbow_clay_xmas"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/white_terracotta"
      }
    }
  }
}