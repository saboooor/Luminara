{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "rebar:background",
        "model": {
          "type": "minecraft:model",
          "model": "rebar:item/ui/background"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "_UI_BACKGROUND"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/gui/background"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/gray_stained_glass_pane"
      }
    }
  },
  "oversized_in_gui": true
}