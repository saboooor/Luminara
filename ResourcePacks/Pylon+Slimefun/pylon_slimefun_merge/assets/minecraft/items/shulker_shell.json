{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:medkit",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/combat/medkit"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "SYNTHETIC_SHULKER_SHELL"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/magical_items/synthetic_shulker_shell"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/shulker_shell"
      }
    }
  }
}