{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:water_breathing_talisman_advanced",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/water_breathing_talisman_advanced"
        }
      },
      {
        "when": "pylon:water_breathing_talisman_palladium",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/water_breathing_talisman_palladium"
        }
      },
      {
        "when": "pylon:water_breathing_talisman_simple",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/water_breathing_talisman_simple"
        }
      },
      {
        "when": "pylon:water_breathing_talisman_ultimate",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/talismans/water_breathing_talisman_ultimate"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "GN_CLAM"
            }
          },
          "model": {
            "type": "model",
            "model": "gastronomicon:ingredient/gn_clam"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/nautilus_shell"
      }
    }
  }
}