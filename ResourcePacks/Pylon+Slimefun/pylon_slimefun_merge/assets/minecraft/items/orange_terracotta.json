{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:fluid_pipe_bronze",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/pipes/bronze_pipe"
        }
      },
      {
        "when": "pylon:smeltery_output_hatch",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/machines/smeltery/smeltery_output_hatch"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "RAINBOW_CLAY_HALLOWEEN"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/halloween/rainbow_clay_halloween"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/orange_terracotta"
      }
    }
  }
}