{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:cargo_filter",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/cargo/cargo_filter"
        }
      },
      {
        "when": "rebar:guide_page:rebar:settings",
        "model": {
          "type": "minecraft:model",
          "model": "rebar:item/ui/settings"
        }
      }
    ],
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "_UI_MENU"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/gui/_ui_menu"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/comparator"
      }
    }
  },
  "oversized_in_gui": true
}