{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:cargo_monitor",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/cargo/cargo_monitor"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "RAINBOW_GLASS_VALENTINE"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/valentine/rainbow_glass_valentine"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/pink_stained_glass"
      }
    }
  }
}