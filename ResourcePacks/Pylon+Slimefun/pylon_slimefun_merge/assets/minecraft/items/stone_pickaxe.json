{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:stone_hammer",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/tools/stone_hammer"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "TOOL_PICKAXE_DUMMY"
            }
          },
          "model": {
            "type": "model",
            "model": "slimetinker:tool_building_guide/tool_pickaxe_dummy"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/stone_pickaxe"
      }
    }
  }
}