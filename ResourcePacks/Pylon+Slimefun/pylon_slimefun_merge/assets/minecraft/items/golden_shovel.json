{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:bronze_screwdriver",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/assembling/bronze_screwdriver"
        }
      },
      {
        "when": "pylon:bronze_shovel",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/tools/bronze_shovel"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "GETGOLD_SPADE"
            }
          },
          "model": {
            "type": "model",
            "model": "bump:tools/getgold_spade"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/golden_shovel"
      }
    }
  }
}