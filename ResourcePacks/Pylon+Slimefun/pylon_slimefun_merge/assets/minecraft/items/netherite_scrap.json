{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:steel_nugget",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/resources/steel_nugget"
        }
      },
      {
        "when": "pylon:wrought_iron",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:item/resources/wrought_iron"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "MAGSTEEL_PLATE"
            }
          },
          "model": {
            "type": "model",
            "model": "infinityexpansion:materials/magsteel_plate"
          }
        },
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "IE_MAGSTEEL_PLATE"
            }
          },
          "model": {
            "type": "model",
            "model": "infinityexpansion2:materials/magsteel_plate"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/netherite_scrap"
      }
    }
  }
}