{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "rebar:page_next",
        "model": {
          "type": "minecraft:model",
          "model": "rebar:item/ui/page_next_on"
        }
      },
      {
        "when": "rebar:page_previous",
        "model": {
          "type": "minecraft:model",
          "model": "rebar:item/ui/page_previous_on"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "infinityexpansion2:display_item": -117,
              "slimefun:slimefun_item": "IE__UI_STORAGE_VOID_EXCESS_ON"
            }
          },
          "model": {
            "type": "model",
            "model": "infinityexpansion2:icons/ui_storage_void_excess_on"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/green_stained_glass_pane"
      }
    }
  },
  "oversized_in_gui": true
}