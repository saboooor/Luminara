{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pylon:fluid_tank_casing_bronze",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/pipes/bronze_tank_casing"
        }
      },
      {
        "when": "pylon:fluid_tank_casing_copper",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/pipes/copper_tank_casing"
        }
      },
      {
        "when": "pylon:portable_fluid_tank_bronze",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/pipes/bronze_portable_tank"
        }
      },
      {
        "when": "pylon:portable_fluid_tank_copper",
        "model": {
          "type": "minecraft:model",
          "model": "pylon:block/machines/pipes/copper_portable_tank"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_data",
      "cases": [
        {
          "when": {
            "PublicBukkitValues": {
              "slimefun:slimefun_item": "RAINBOW_GLASS_HALLOWEEN"
            }
          },
          "model": {
            "type": "model",
            "model": "slimefun:slimefun/halloween/rainbow_glass_halloween"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/orange_stained_glass"
      }
    }
  }
}